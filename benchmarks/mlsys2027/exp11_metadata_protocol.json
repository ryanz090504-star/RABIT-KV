      ]
    }
  },
  "only_metadata_field_differs_proof": {
    "control": "rabit2",
    "fields_differing_from_control_excluding_display_name": {
      "rabit2_mbf": [
        "metadata_mode"
      ],
      "rabit2_m32": [
